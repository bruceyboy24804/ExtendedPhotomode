<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Deliberately NOT in ExtendedPhotomode.sln.

      A root `dotnet build` builds the solution, and the mod's build already has a fragile step in it
      (DeployWIP wipes the mod folder and fails while the game holds the DLL). Adding a second project
      to that build gives it another way to fail for reasons that have nothing to do with the mod.
      This is run on demand instead, and its output is committed.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>ExtendedPhotomode.Codegen</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    </ItemGroup>

</Project>
