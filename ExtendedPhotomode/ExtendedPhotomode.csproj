<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Title>Extended Photomode</Title>
        <Version>1.2.0</Version>
        <AssemblyVersion>$(Version).0</AssemblyVersion>
        <FileVersion>$(Version).0</FileVersion>
        <PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
    </PropertyGroup>

    <!-- Don't compile the submodule's own build output -->
    <PropertyGroup>
        <DefaultItemExcludes>$(DefaultItemExcludes);Common\obj\**;Common\bin\**</DefaultItemExcludes>
    </PropertyGroup>

    <!-- Shared build config: package refs, LangVersion, configs (Debug;Release;I18N), <Reference> list -->
    <Import Project="Common\ModsCommon.props" />

    <!-- CSII toolchain -->
    <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" />
    <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets" />

    <!-- Shared build steps. MUST be imported AFTER Mod.targets so the shared
         CustomModPostProcessorConfig overrides the toolchain's stub (Windows-only build). -->
    <Import Project="Common\ModsCommon.targets" />

    <!-- Volume / VolumeProfile live here; ModsCommon.props only brings in HDRP.Runtime. -->
    <ItemGroup>
        <Reference Include="Unity.RenderPipelines.Core.Runtime">
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- Keep these links if you like seeing Mod.props/targets in the IDE (optional) -->
    <ItemGroup>
        <None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
        <None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
    </ItemGroup>
    <!--
      Ship the UI assets alongside the DLL.

      ModsCommonBase registers a host location at "<mod folder>/Assets/" so the UI can reach these as
      coui://extendedphotomode/... — but it skips registration when that directory is missing, which
      is what a mod with no assets looks like. Nothing in the toolchain copies the folder: a bare
      <Folder Include> is only a design-time marker for the IDE. Without this target the icons stay in
      the source tree, the host is never registered, and every request for one fails with
      "Invalid host locations map".

      RecursiveDir is relative to the wildcard root, so "Assets\**\*" yields "Camera_Icons\" and the
      Assets prefix has to be written back into the destination.
    -->
    <ItemGroup>
        <Content Include="Assets\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <ItemGroup>
        <Folder Include="Assets\Camera_Icons\" />
        <Folder Include="Assets\Cover\" />
        <Folder Include="Assets\Sorting\" />
        <Folder Include="Systems\ShotType\Dolley\" />
    </ItemGroup>

    <!-- OPTIONAL: skip the overlay renderer if your mod doesn't use it -->
    <!-- <ItemGroup><Compile Remove="Common\Rendering\**\*.cs" /></ItemGroup> -->

</Project>